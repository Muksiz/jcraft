# Copy to .env and fill in. .env is gitignored.

# On the Pi: "pi" enables backup, ddns and tunnel. On the desktop: leave empty.
COMPOSE_PROFILES=pi

# JVM heap. 5G leaves room for the OS and the other containers on an 8 GB Pi.
MEMORY=5G
# Heap for pre-generation on the desktop.
PREGEN_MEMORY=8G

# World seed. Empty = random. Only used when the world is first created.
SEED=

# Comma-separated Java Edition profile names.
WHITELIST=
OPS=

# Long random string, e.g. `openssl rand -hex 24`. Never port-forward RCON.
RCON_PASSWORD=

# Cloudflare API token with Zone > DNS > Edit on janix.fi.
CLOUDFLARE_API_TOKEN=
MC_DOMAIN=mc.janix.fi
# Token of the Cloudflare Tunnel that routes map.janix.fi -> http://mc:8100
CLOUDFLARE_TUNNEL_TOKEN=

# Used by the desktop scripts (sync-world.sh, backup-pull.sh).
PI_HOST=pi
PI_DIR=jcraft

# Pre-generation radii in blocks. The world itself has no border.
PREGEN_RADIUS_OVERWORLD=5000
PREGEN_RADIUS_NETHER=1000
PREGEN_RADIUS_END=3000
